APP_ENV=production
APP_TIMEZONE=America/Sao_Paulo

# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For.
# Keep empty unless the reverse proxy network is explicitly known.
TRUSTED_PROXY_IPS=

# Required database URL.
# Supabase pooled connection example:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>?sslmode=require

# Required admin key for /admin/* and the internal admin dashboard.
ADMIN_API_KEY=<strong-admin-api-key>
MONITOR_BOT_API_KEY=<dedicated-monitor-bot-api-key>
MONITOR_BOT_ENABLED=false
MONITOR_BOT_TELEGRAM_BOT_TOKEN=<telegram-bot-token>
MONITOR_BOT_TELEGRAM_USER_IDS=7609256077
MONITOR_BOT_API_URL=http://monitor-comunitario-api:8000
REDIS_PASSWORD=<strong-redis-password>
REDIS_URL=redis://:<strong-redis-password>@redis:6379/0

PUBLIC_REGISTRATION_ENABLED=false
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TTL_SECONDS=900
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-user>
SMTP_PASSWORD=<smtp-password>
SMTP_TLS=true
EMAIL_FROM=monitor@monitor-mail.soberania.cloud
EMAIL_PROVIDER=brevo
BREVO_API_KEY=<brevo-api-key>
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_INGRESS_SECRET=<strong-email-ingress-secret>
EMAIL_INGRESS_ALLOWED_RECIPIENTS=monitor@monitor-mail.soberania.cloud
EMAIL_INGRESS_MAX_RAW_BYTES=10485760

CELESC_OUTAGES_URL=https://www.celesc.com.br/avisos-de-desligamentos
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=30000
SNAPSHOT_DIR=/app/snapshots

SCHEDULER_ENABLED=true
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0

NOTIFICATION_PROVIDER=app

EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_ENABLED=false
MEMBER_AREA_URL=https://monitorcomunitario.soberania.cloud/member
HERMES_CALLBACK_SECRET=<strong-hermes-callback-secret>
HERMES_EVENT_API_SECRET=<strong-hermes-event-api-secret>

HERMES_TELEGRAM_ENABLED=false
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_CHAT_ID=
HERMES_TELEGRAM_API_BASE_URL=https://api.telegram.org

ADS_ENABLED=false
ADS_PROVIDER=placeholder
ADSENSE_CLIENT_ID=
ADSENSE_DEFAULT_SLOT=

ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=none
GOOGLE_ANALYTICS_ID=

CONSENT_REQUIRED=true
CONSENT_VERSION=2026-06-16-v1
