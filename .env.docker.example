APP_ENV=docker
APP_TIMEZONE=America/Sao_Paulo

# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For.
# Keep empty unless the reverse proxy network is explicitly known.
TRUSTED_PROXY_IPS=
DATABASE_URL=postgresql+psycopg://monitor:monitor@postgres:5432/monitor_comunitario
ADMIN_API_KEY=change-me-local-admin-key
MONITOR_BOT_API_KEY=change-me-local-monitor-bot-key
REDIS_URL=redis://redis:6379/0

CELESC_OUTAGES_URL=https://www.celesc.com.br/avisos-de-desligamentos
CELESC_EMERGENCY_URL=https://celgeoweb.celesc.com.br/json/mapa.js
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=30000
SNAPSHOT_DIR=/app/snapshots

SCHEDULER_ENABLED=true
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0

NOTIFICATION_PROVIDER=app

EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_ENABLED=false

HERMES_TELEGRAM_ENABLED=false
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_CHAT_ID=
HERMES_TELEGRAM_API_BASE_URL=https://api.telegram.org
MONITOR_BOT_API_URL=http://monitor-comunitario-api:8000

ADS_ENABLED=false
ADS_PROVIDER=placeholder
ADSENSE_CLIENT_ID=
ADSENSE_DEFAULT_SLOT=

ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=none
GOOGLE_ANALYTICS_ID=

CONSENT_REQUIRED=true
CONSENT_VERSION=2026-06-16-v1
